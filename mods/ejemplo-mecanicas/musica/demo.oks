// Mapa de ejemplo (.oks). Tiempos en milisegundos. Columnas: 0=izq 1=arriba 2=abajo 3=der.
// Formato de nota:  [tiempo, columna, { extras }]
//   extras: hold (ms), tag ("rebote" | "bomba" | "pulso" | ...), cambio: [tiempo, columnaNueva]
{
    nombre: "Demo del Laboratorio",
    autor: "OKAOS Team",
    creador: "OKAOS Team",
    dificultad: "Lab",
    star: 3,
    bpm: 120,
    duracion: "00:50",
    puntos: 8600,
    audio: "demo.ogg",
    fondo: "fondo.jpg",
    video: "demo.mp4",
    velocidad: [
        { time: 0, valor: 1 },
        { time: 24000, valor: 1.15 },
        { time: 40000, valor: 1.4 }
    ],
    textos: [
        { time: 1000, texto: "Laboratorio de Mecánicas", duracion: 2600 },
        { time: 7500, texto: "Mantén la tecla presionada", duracion: 2600 },
        { time: 15500, texto: "Rebote: pulsa dos veces", duracion: 2600 },
        { time: 23500, texto: "Cambio de carril", duracion: 2600 },
        { time: 31500, texto: "¡Cuidado con las bombas!", duracion: 2600 },
        { time: 39500, texto: "Mecánicas propias del mod", duracion: 2600 }
    ],
    notas: [
        // --- Intro: notas normales ---
        [2000, 0],
        [2500, 1],
        [3000, 2],
        [3500, 3],
        [4000, 2],
        [4500, 1],
        [5000, 0],
        [5500, 1],
        [6000, 2],
        [6500, 3],
        [7000, 2],
        [7500, 1],
        // --- Hold: mantén la tecla ---
        [8000, 0, { hold: 1500 }],
        [8500, 2],
        [9000, 3],
        [9500, 1],
        [10000, 2, { hold: 1000 }],
        [10500, 3],
        [11000, 0],
        [11500, 1, { hold: 1500 }],
        [12500, 2],
        [13000, 3],
        [13500, 3, { hold: 1000 }],
        [14000, 1],
        [14500, 0, { hold: 1200 }],
        [15000, 2],
        [15500, 3],
        // --- Rebote: pulsa dos veces ---
        [16000, 0, { tag: "rebote" }],
        [16500, 1, { tag: "rebote" }],
        [17000, 3],
        [17500, 2, { tag: "rebote" }],
        [18000, 3, { tag: "rebote" }],
        [18500, 2, { tag: "rebote" }],
        [19000, 0],
        [19500, 1, { tag: "rebote" }],
        [20000, 0, { tag: "rebote" }],
        [20500, 2],
        [21000, 3, { tag: "rebote" }],
        [21500, 2, { tag: "rebote" }],
        [22000, 1, { tag: "rebote" }],
        [22500, 0],
        [23000, 3],
        [23500, 1],
        // --- Cambio de carril ---
        [24500, 0, { cambio: [23900, 2] }],
        [25000, 2],
        [25500, 1, { cambio: [24900, 3] }],
        [26000, 1],
        [26500, 3, { cambio: [25900, 0] }],
        [27000, 0],
        [27500, 2, { cambio: [26900, 1] }],
        [28000, 3],
        [28500, 0, { cambio: [27900, 3] }],
        [29000, 2],
        [29500, 1, { cambio: [28900, 2] }],
        [30000, 0],
        [30500, 3, { cambio: [29900, 1] }],
        [31000, 1],
        [31500, 3],
        // --- Bombas: no las pulses ---
        [32500, 0],
        [33000, 1, { tag: "bomba" }],
        [33500, 3],
        [34000, 2, { tag: "bomba" }],
        [34500, 1],
        [35000, 0, { tag: "bomba" }],
        [35500, 2],
        [36000, 0],
        [36500, 3, { tag: "bomba" }],
        [37000, 2],
        [37500, 1, { tag: "bomba" }],
        [38000, 3],
        [38500, 2, { tag: "bomba" }],
        [39000, 0, { tag: "bomba" }],
        [39500, 1],
        // --- Mecánicas propias: pulso y fantasma ---
        [40500, 1, { tag: "pulso" }],
        [41000, 3, { tag: "pulso" }],
        [41500, 0, { tag: "pulso" }],
        [42000, 2, { tag: "pulso" }],
        [42500, 1, { tag: "pulso" }],
        [43000, 3, { tag: "pulso" }],
        [43500, 2, { tag: "fantasma" }],
        [44000, 0, { tag: "fantasma" }],
        [44500, 3, { tag: "fantasma" }],
        [45000, 1, { tag: "fantasma" }],
        [45500, 2, { tag: "fantasma" }],
        [46000, 0, { tag: "fantasma" }],
        [46500, 3, { tag: "fantasma" }],
    ]
}
